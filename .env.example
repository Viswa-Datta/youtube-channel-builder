# ============================================================================
# YouTube Channel Builder — every variable, no real values. Copy to .env (worker)
# and web/.env.local (web). Never commit real keys. See docs/SETUP-KEYS.md.
# ============================================================================

# ---------- Web app (Vercel) ----------
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app          # used for OAuth redirect URIs
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=                           # Supabase > Project Settings > API (anon/public)
SUPABASE_SERVICE_ROLE_KEY=                               # server only; never exposed to the browser
STORAGE_DRIVER=supabase                                  # supabase | local (local = dev only)
STORAGE_BUCKET=projects
NEXT_PUBLIC_OPERATOR_NAME=                               # shown in the privacy policy
NEXT_PUBLIC_CONTACT_EMAIL=

# YouTube connection (Google Cloud OAuth client, type "Web application")
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=                                    # openssl rand -base64 32  (same value in web and worker)
YOUTUBE_API_AUDITED=false                                # set true only after Google approves your API audit

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---------- Worker (Fly.io / Railway / VPS) ----------
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres   # Supabase > Connect > Session pooler
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY (same as above)
WORK_DIR=/work
JOB_LEASE_SECONDS=90
JOB_POLL_SECONDS=2

# LLM providers — set at least one. Free: GEMINI_API_KEY (free tier) or OLLAMA_URL (self-hosted).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_URL=                                              # e.g. http://localhost:11434
ALLOW_FIXTURES=false                                     # true ONLY in tests; production refuses fixture output

# Voice — Kokoro is free and needs no key. Paid voices are optional.
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=                                      # Cloud Text-to-Speech API key (Chirp 3 HD)
KOKORO_MODEL=/models/kokoro-v1.0.onnx
KOKORO_VOICES=/models/voices-v1.0.bin
KOKORO_VOCAB=/models/kokoro-vocab.json
ESPEAK_BIN=espeak-ng

# Blur pipeline models (downloaded by worker/scripts/download-models.sh)
FACE_MODEL=/models/face_detection_yunet_2023mar.onnx
PLATE_MODEL=/models/yolo-v9-t-384-license-plates-end2end.onnx

# Footage + research (server-side only)
PEXELS_API_KEY=
PIXABAY_API_KEY=
COURTLISTENER_TOKEN=                                     # free; court records come first in research
NARA_API_KEY=                                            # optional; National Archives catalog API

# Music: drop YouTube Audio Library tracks into MUSIC_DIR or upload per project; otherwise a generated ambient bed is used.
MUSIC_DIR=/app/assets/music
